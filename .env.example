# Database
DATABASE_URL=postgres://gateway:gateway@localhost:5432/agent_gateway?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# JWT
JWT_SECRET=change-me
JWT_ISSUER=agent-gateway
JWT_AUDIENCE=agent-gateway-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MIN=120
RATE_LIMIT_TOKENS_PER_MIN=50000
RATE_LIMIT_TOOL_EXECS_PER_MIN=30

# OpenTelemetry
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=stdout
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=stdout
OTEL_SERVICE_NAME=agent-gateway

# Server
HTTP_ADDR=:8080
ENVIRONMENT=development