  "cards": [
    {
      "dot": "cyan",
      "title": "Request Pipeline",
      "items": [
        "Chi router with structured middleware chain",
        "Auth → Tenant → Delegation → RateLimit → Audit → Guardrails → HITL",
        "Each middleware independently testable"
      ]
    },
    {
      "dot": "emerald",
      "title": "Chat Orchestration",
      "items": [
        "Fallback chain: circuit breaker + retry + cost-aware routing",
        "Tool loop: bounded iterations, revocation check, hash re-resolution",
        "HITL gate: approval for sensitive tool calls",
        "Cost tracking: pre-estimate + post-actual pricing"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Guardrails",
      "items": [
        "JWT with key rotation (KeyStore v1+)",
        "Composite guardrail: local (PII, injection) + external (LlamaGuard, OpenAI)",
        "Delegation: depth/fan-out limits + Redis-backed budget",
        "Audit: append-only log with chain verification"
      ]
    },
    {
      "dot": "amber",
      "title": "Data & Infrastructure",
      "items": [
        "PostgreSQL: primary store (sqlc, Goose migrations)",
        "Redis: rate limiting, quota resolution, delegation budget",
        "Multi-tenant: row-level isolation via tenant middleware"
      ]
    },
    {
      "dot": "violet",
      "title": "Provider Adapters",
      "items": [
        "OpenAI, Anthropic, Ollama via common ModelProvider interface",
        "WASM tool execution (wazero) with resource limits",
        "Mock executor for testing"
      ]
    }
  ]
